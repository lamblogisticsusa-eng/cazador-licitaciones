# Copia esto a .env o configuralo en Render > Environment.
# NUNCA subas un archivo con claves reales a GitHub.

# Telegram: @BotFather -> /newbot  -> te da el token
TELEGRAM_BOT_TOKEN=
# Tu user id numerico. Hablale a @userinfobot si no lo sabes.
TELEGRAM_CHAT_ID=

# SAM.gov: https://open.gsa.gov/api/get-opportunities-public-api/
# Empieza con "SAM-"
SAM_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
# Desde mayo 2026 ya NO exige el prefijo "AIza" (las auth keys empiezan con AQ).
# Lo que si importa:
#   - copiala COMPLETA (~53 caracteres, incluye un punto)
#   - NO le pongas restriccion de IP: Render usa IPs dinamicas y fallaria ahi
#   - la API Generative Language debe estar habilitada en el proyecto
GEMINI_API_KEY=

# --- Opcionales ---
GEMINI_MODEL=gemini-2.5-flash
DIAS_DE_VENTANA=3
DIAS_POR_CHUNK=2
MAX_A_GEMINI=25
MAX_NOTIFICACIONES=10
PUNTAJE_MINIMO=6
TOPE_USD=250000
MIN_USD=5000
INTERVALO_HORAS=24
WORKERS=8
DRY_RUN=0
