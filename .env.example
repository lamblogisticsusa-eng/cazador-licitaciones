# Copia esto a .env o configuralo en Render > Environment.
# NUNCA subas un archivo con claves reales a GitHub.

# Telegram: @BotFather -> /newbot  -> te da el token
TELEGRAM_BOT_TOKEN=
# Tu user id numerico. Hablale a @userinfobot si no lo sabes.
TELEGRAM_CHAT_ID=

# SAM.gov: https://open.gsa.gov/api/get-opportunities-public-api/
# Empieza con "SAM-"
SAM_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
# DEBE empezar con "AIza" -- si empieza con otra cosa, NO funciona.
GEMINI_API_KEY=

# --- Opcionales ---
GEMINI_MODEL=gemini-2.5-flash
DIAS_DE_VENTANA=5
DIAS_POR_CHUNK=2
MAX_A_GEMINI=15
PUNTAJE_MINIMO=2
TOPE_USD=250000
MIN_USD=5000
INTERVALO_HORAS=4
WORKERS=8
DRY_RUN=0
